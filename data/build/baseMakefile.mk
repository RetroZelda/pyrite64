###################################
## THIS FILE IS AUTOGENERATED!   ##
## If you need custom logic      ##
## please edit Makefile.custom   ##
###################################

BUILD_DIR=build
ENGINE_DIR=engine
ROM_NAME={{ROM_NAME}}

export N64_INST={{N64_INST}}

include $(N64_INST)/include/n64.mk
include $(N64_INST)/include/t3d.mk

# recursive wildcard
rwildcard = $(foreach d,$(wildcard $(1:=/*)),$(call rwildcard,$d,$2) $(filter $(subst *,%,$2),$d))

N64_CXXFLAGS += -std=gnu++20 -fno-exceptions -O3 -Isrc -Isrc/user \
	-I$(ENGINE_DIR)/include \
	-MP

# n64.mk adds -MMD; -MP additionally emits a phony target per header so that
# deleting/renaming a header doesn't break incremental builds with
# "No rule to make target" once the .d files below are included.
CFLAGS += -MP
CXXFLAGS += -MP

# Allow custom attributes, otherwise GCC (rightfully) complains unknown ones
$(BUILD_DIR)/src/user/%.o: N64_CXXFLAGS += -Wno-attributes

src =  $(wildcard src/*.cpp) $(wildcard src/p64/*.cpp) $(wildcard src/user/*.cpp)

{{USER_CODE_DIRS}}

all: $(ROM_NAME).z64

include Makefile.custom

# Engine changes don't force project recompiles: project objects list the engine
# headers they include in their .d files, and the .elf below relinks via engine.a.
$(ENGINE_DIR)/build/engine.a: FORCE
	$(MAKE) -C $(ENGINE_DIR) ENGINE_CXXFLAGS="$(ENGINE_CXXFLAGS)"
FORCE: ;

AUDIOCONV_FLAGS = --wav-resample 24000 --wav-compress 1

assets_conv = {{ASSET_LIST}}
assets_conv += filesystem/p64/font.ia4.sprite

# Images
filesystem/%.sprite: assets/p64/font.ia4.png
	@mkdir -p $(dir $@)
	@echo "    [SPRITE] $@"
	$(N64_MKSPRITE) $(MKSPRITE_FLAGS) -o $(dir $@) "$<"

filesystem/p64/%: assets/p64/%
	@mkdir -p $(dir $@)
	@echo "    [P64-BIN] $@"
	$(N64_BINDIR)/mkasset -c 1 -w 256 -o $(dir $@) "$<"

build/%.dfs:
	@mkdir -p $(dir $@)
	@echo "    [DFS*] $@ $(<D)"
	$(N64_MKDFS) $@ filesystem >/dev/null

$(BUILD_DIR)/$(ROM_NAME).dfs: $(assets_conv)
$(BUILD_DIR)/$(ROM_NAME).elf: $(src:%.cpp=$(BUILD_DIR)/%.o) $(ENGINE_DIR)/build/engine.a

$(ROM_NAME).z64: N64_ROM_TITLE="{{PROJECT_NAME}}"
{{ROM_HEADER_FLAGS}}
$(ROM_NAME).z64: $(BUILD_DIR)/$(ROM_NAME).dfs

clean:
	{{P64_SELF_PATH}} --cli --cmd clean {{PROJECT_SELF_PATH}}

p64:
	{{P64_SELF_PATH}} --cli --cmd build {{PROJECT_SELF_PATH}}

# Compiler-generated header dependencies (-MMD) live next to each .o in nested
# subdirs (src/p64/, src/user/**, lib/**), so they must be collected recursively over the
# whole build dir — stale objects would otherwise keep baked-in asset indices.
-include $(call rwildcard,$(BUILD_DIR),*.d)

.PHONY: all clean
